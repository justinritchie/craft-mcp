# Per-workspace credentials for craft-mcp.
#
# Copy this file to ~/.mcp-credentials/craft-<workspace>.env (one per workspace),
# fill in the real values, then run ./setup-workspace.sh <workspace>.
#
# Get CRAFT_API_BASE_URL and CRAFT_API_KEY from Craft → Settings → AI Bundle →
# API Access. The link ID in the URL identifies the workspace; the pdk_*
# token is the Bearer credential.
#
# CRAFT_MCP_PORT must be unique per workspace if you're running more than one.

CRAFT_API_BASE_URL="https://connect.craft.do/links/<your-link-id>/api/v1"
CRAFT_API_KEY="pdk_xxxxxxxxxxxxxxxxxxxxxxxx"
CRAFT_MCP_PORT=8003

# Optional — defaults to "craft-<workspace>" if unset:
# CRAFT_MCP_SERVER_NAME="craft-jumbo"

# Optional — appended to every MCP tool name so multiple instances of this
# server don't collide in the same client. Leave unset for single-workspace
# setups; set to "_<workspace>" (e.g. "_jumbo", "_xe", "_personal") for
# multi-workspace setups. Example: get_blocks → get_blocks_jumbo.
# CRAFT_MCP_TOOL_SUFFIX="_jumbo"

# Optional — human-readable account label prepended to every tool's
# description as "[Craft account: <label>] ...". Lets MCP clients (and the
# LLMs driving them) disambiguate the right Craft workspace via semantic
# search instead of guessing from tool name suffixes alone. Defaults to a
# derivation from CRAFT_MCP_TOOL_SUFFIX (jumbo → "Jumbo", xe → "XE Network",
# personal → "Personal"); override for anything else.
# CRAFT_ACCOUNT_LABEL="Jumbo (justin@jumbo.live)"
