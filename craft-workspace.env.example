# Per-workspace credentials for craft-mcp.
#
# Copy this file to ~/.mcp-credentials/craft-<workspace>.env (one per workspace),
# fill in the real values, then run ./setup-workspace.sh <workspace>.
#
# Get CRAFT_API_BASE_URL and CRAFT_API_KEY from Craft → Settings → AI Bundle →
# API Access. The link ID in the URL identifies the workspace; the pdk_*
# token is the Bearer credential.
#
# CRAFT_MCP_PORT must be unique per workspace if you're running more than one.

CRAFT_API_BASE_URL="https://connect.craft.do/links/<your-link-id>/api/v1"
CRAFT_API_KEY="pdk_xxxxxxxxxxxxxxxxxxxxxxxx"
CRAFT_MCP_PORT=8003

# Optional — defaults to "craft-<workspace>" if unset:
# CRAFT_MCP_SERVER_NAME="craft-jumbo"
